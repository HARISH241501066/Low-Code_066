		 functions
		 {
			 Deluge
			 {
				 void Get_Exchange_Rates()
                 {
                 	// DS-09 | REST API call with invokeurl (public Frankfurter API, no key needed)
                 	// Gets today's value of 1 INR in USD and EUR for foreign remittance desk
                 	response = invokeurl
                 	[
                 		url :"https://api.frankfurter.app/latest?from=INR&to=USD,EUR"
                 		type :GET
                 	];
                 	info "API response: " + response;
                 	rates = response.get("rates");
                 	info "1 INR = " + rates.get("USD") + " USD";
                 	info "1 INR = " + rates.get("EUR") + " EUR";
                 	info "Rs. 1,00,000 = " + (100000 * rates.get("USD").toDecimal()).round(2) + " USD";
                 }
				 void Load_Sample_Data()
                 {
                 	// 1. Create branches only if they do not exist
                 	branchData = {"Thandalam":"BANK0001234","Poonamallee":"BANK0001235","T Nagar":"BANK0001236"};
                 	for each  bName in branchData.keys()
                 	{
                 		if(Branch_Master[Branch_Name == bName].count() == 0)
                 		{
                 			insert into Branch_Master
                 			[
                 				Added_User=zoho.loginuser
                 				Branch_Name=bName
                 				IFSC_Code=branchData.get(bName)
                 				City="Chennai"
                 			]
                 		}
                 	}
                 	// 2. Link every account without a branch to a branch (round robin)
                 	branchIds = Branch_Master[ID != 0].ID.getAll();
                 	i = 0;
                 	for each  acc in Account_Opening_Form[Branch_Master == null]
                 	{
                 		acc.Branch_Master=branchIds.get(i % branchIds.size());
                 		i = i + 1;
                 	}
                 	// 3. Correct the cash deposit entry that was saved as a withdrawal
                 	for each  t in Transaction_Form[Remarks == "Cash deposit at branch" && Transaction_Type == "Withdrawal"]
                 	{
                 		t.Transaction_Type="Deposit";
                 		acc = Account_Opening_Form[ID == t.Account];
                 		acc.Current_Balance=acc.Current_Balance + 2 * t.Amount;
                 	}
                 	info "Branches: " + Branch_Master[ID != 0].count() + ", accounts linked: " + i;
                 }
			 }
		 }


		workflow
		{
		form
		{
			Set_Opening_Balance as "Set Opening Balance"
			{
				type =  form
				form = Account_Opening_Form

				record event = on add

				on validate
				{
					actions 
					{
						custom deluge script
						(
											// Set the opening balance and submission time for a new account
										input.Current_Balance = input.Opening_Deposit;
										input.Submitted_On = zoho.currenttime;
										if(input.Opening_Deposit < 1000)
										{
											alert "Minimum opening deposit is Rs. 1000";
											cancel submit;
										}
						)
					}
				}

			}
			Account_Confirmation_Emai as "Account Confirmation Email"
			{
				type =  form
				form = Account_Opening_Form

				record event = on add

				on success
				{
					actions 
					{
						custom deluge script
						(
											// Send a confirmation email when a new account request is submitted
										sendmail
										[
											from :zoho.adminuserid
											to :zoho.loginuserid
											subject :"Account Opening Request Received - " + input.Account_Number
											message :"Dear " + input.Customer_Name + ",<br><br>Thank you for your account opening request.<br>Account Number: " + input.Account_Number + "<br>Account Type: " + input.Account_Type + "<br>Opening Deposit: Rs. " + input.Opening_Deposit + "<br><br>Our branch team will verify your KYC and contact you soon.<br><br>Regards,<br>Bank Team"
										]
						)
					}
				}

			}
			Check_and_Update_Balance as "Check and Update Balance"
			{
				type =  form
				form = Transaction_Form

				record event = on add

				on validate
				{
					actions 
					{
						custom deluge script
						(
											// Check balance before withdrawal / transfer and update the account balance
										acc = Account_Opening_Form[ID == input.Account];
										if(acc.count() == 0)
										{
											alert "Please select a valid account.";
											cancel submit;
										}
										else
										{
											balance = ifnull(acc.Current_Balance,0);
											if(input.Transaction_Type != "Deposit" && input.Amount > balance)
											{
												alert "Insufficient balance. Available balance: Rs. " + balance;
												cancel submit;
											}
											else
											{
												if(input.Transaction_Type == "Deposit")
												{
													acc.Current_Balance=balance + input.Amount;
												}
												else
												{
													acc.Current_Balance=balance - input.Amount;
												}
												if(input.Transaction_Date == null)
												{
													input.Transaction_Date = zoho.currentdate;
												}
											}
										}
						)
					}
				}

			}
			Calculate_EMI as "Calculate EMI"
			{
				type =  form
				form = Loan_Application_Form

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											// Calculate monthly EMI using the reducing balance formula
										P = ifnull(input.Loan_Amount,0);
										yearlyRate = ifnull(input.Loan_Interest_Rate,0);
										N = ifnull(input.Tenure_Months,0);
										if(P <= 0 || N <= 0)
										{
											alert "Loan amount and tenure must be greater than zero.";
											cancel submit;
										}
										else
										{
											R = (yearlyRate / 12) / 100;
											if(R == 0)
											{
												input.Monthly_EMI = (P / N).round(2);
											}
											else
											{
												factor = (1 + R).power(N);
												input.Monthly_EMI = (P * R * factor / (factor - 1)).round(2);
											}
											if(input.Loan_Status == null)
											{
												input.Loan_Status = "Applied";
											}
										}
						)
					}
				}

			}
		}

		schedule
		{
			Daily_FD_Maturity_Reminde as "Daily FD Maturity Reminder"
			{
				type =  schedule
				start = "2026-10-17 21:25:16"
				frequency = daily
				time zone = "Asia/Kolkata"
				on start
				{
					actions 
					{
					on load
					(
						// Runs daily: remind customers whose fixed deposit matures in the next 7 days
										todayDate = zoho.currentdate;
										endDate = todayDate.addDay(7);
										count = 0;
										for each  acc in Account_Opening_Form[FD_Maturity_Date >= todayDate && FD_Maturity_Date <= endDate && Account_Status == "Active"]
										{
											sendmail
											[
												from :zoho.adminuserid
												to :zoho.adminuserid
												subject :"FD Maturity Reminder - Account " + acc.Account_Number
												message :"Dear Customer,<br><br>Your Fixed Deposit of Rs. " + acc.FD_Amount + " in account " + acc.Account_Number + " will mature on " + acc.FD_Maturity_Date + ".<br>Please visit the branch to renew or withdraw.<br><br>Regards,<br>Bank Team"
											]
											count = count + 1;
										}
										info "FD reminders sent: " + count;
					)
					}
				}
			}
		}

		approval
		{
			High_Value_Loan_Approval as "High Value Loan Approval"
			{
				type =  approval
				form = Loan_Application_Form[Loan_Amount > 500000]
				display fields = [Loan_Type,Tenure_Months,Loan_Status,Loan_Amount,Loan_Interest_Rate,Monthly_EMI,Account]
				on start
				{
				}
				on level 1
				{
					on approve 
					{
						actions 
						{
							sendmail
							(
								from : zoho.loginuserid
								to : approver.submitter
								subject : "Approval Request"
								message : "Your request has been approved."
							)
						}
						actions 
						{
						on load
						(
							// Mark the loan as approved by the branch manager
												input.Loan_Status = "Approved";
						)
						}
					}
					on reject
					{

						actions 
						{
							sendmail
							(
								from : zoho.loginuserid
								to : approver.submitter
								subject : "Approval Request"
								message : "Your request has been rejected."
							)
						}
					}
				}
			}
		}

