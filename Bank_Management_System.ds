 * Generated on : 17-Oct-2026 09:22:59
 * Version      : 1.0
 */
 application "Bank Management System"
 {
 	date format = "dd-MMM-yyyy"
 	time zone = "Asia/Kolkata"
 	time format = "24-hr"

 	forms
	{
		form Account_Opening_Form
		{
			displayname = "Account Opening Form"
			success message = "Data Added Successfully!"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			must have Customer_Name
			(
    			type = name
				displayname = "Customer Name"
     			prefix
     			(
	     			 type = prefix
	     			 displayname ="Prefix"
	     			 visibility = false
	     			 value = {"Mr.","Mrs.","Ms."}
     			) 
     			first_name
     			(
	     			 type = first_name
	     			 displayname ="First Name"
     			) 
     			last_name
     			(
	     			 type = last_name
	     			 displayname ="Last Name"
     			) 
     			suffix
     			(
	     			 type = suffix
	     			 displayname ="Suffix"
	     			 visibility = false
     			) 
	 			row = 1
	 			column = 1   
				width = medium
				personal data = true
			)
			Email_Address
			(
    			type = email
				displayname = "Email Address"
				maxchar = 80
	 			row = 1
	 			column = 1   
				width = medium
				personal data = true
			)
			Mobile_Number
			(
    			type = phonenumber
				displayname = "Mobile Number"
	 			row = 1
	 			column = 1   
				width = medium
				personal data = true
			)
			Residential_Address
			(
    			type = address
				displayname = "Residential Address"
     			capture_coordinates = true
     			adjust_using_map = false
     			address_line_1
     			(
	     			  type = address_line_1
	     			  displayname = "Address Line 1"
     			) 
     			address_line_2
     			(
	     			  type = address_line_2
	     			  displayname = "Address Line 2"
     			) 
     			district_city
     			(
	     			  type = district_city
	     			  displayname = "City / District"
     			) 
     			state_province
     			(
	     			  type = state_province
	     			  displayname = "State / Province"
     			) 
     			postal_Code
     			(
	     			  type = postal_Code
	     			  displayname = "Postal Code"
     			) 
     			country
     			(
	     			  type = country
	     			  displayname = "Country"
     			) 
     			latitude
     			(
	     			  type = latitude
	     			  displayname = "latitude"
	     			 visibility = false
     			) 
     			longitude
     			(
	     			  type = longitude
	     			  displayname = "longitude"
	     			 visibility = false
     			) 
	 			row = 1
	 			column = 1   
				width = medium
				personal data = true
			)
			PAN_Number
			(
    			type = text
				displayname = "PAN Number"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Opening_Deposit
			(
				type = number
				displayname = "Opening Deposit"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Date_of_Birth
			(
    			type = date
				displayname = "Date of Birth"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			Purpose_of_Account
			(
    			type = textarea
				displayname = "Purpose of Account"
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
			Preferred_Visit_Time
			(
    			type = time
				displayname = "Preferred Visit Time"
				timedisplayoptions = "hh:mm:ss" 
	 			row = 1
	 			column = 1   
				width = medium
			)
			Account_Type
			(
				type = picklist
				displayname = "Account Type"
				maxchar = 100
				values = {"Recurring Deposit","Savings","Current","Fixed Deposit"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			Customer_Category
			(
				type = radiobuttons
				displayname = "Customer Category"
				maxchar = 100
				values = {"Individual","Senior Citizen","Student"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			Services_Required
			(
				type = list	
				displayname = "Services Required"
				values = {"ATM Card","Net Banking","SMS Alerts"}
				height = 60px
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Agree_To_Bank_Terms
			(
				type = checkboxes	
				displayname = "Agree To Bank Terms"
				values = {"I agree to the bank terms and conditions"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			Customer_Photo
			(
    			type = image
				displayname = "Customer Photo"
				source  = file
				aspect ratio = original
				camera = primary
				show gallery = true
				switch camera = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			Branch_Master
			(
				type = picklist	
				displayname = "Branch Master"
				values  = Branch_Master.ID
    			displayformat = [Branch_Name]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			KYC_Document
			(
    			type = upload file
				displayname = "KYC Document"
				browse = local_drive
	 			row = 1
	 			column = 1   
				width = medium
			)
			Current_Balance
			(
				displayname = "Current Balance"
				type = INR
				format = commadotindian
	 			row = 1
	 			column = 1   
				width = medium
			)
			FD_Amount
			(
				displayname = "FD Amount"
				type = INR
				format = commadotindian
	 			row = 1
	 			column = 1   
				width = medium
			)
			Interest_Rate
			(
    			type = percentage
				displayname = "Interest Rate"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Submitted_On
			(
    			type = datetime
				displayname = "Submitted On"
				timedisplayoptions = "hh:mm:ss"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			Company_Website
			(
    			type = url
				displayname = "Company Website"
				enable  linkname
	 			row = 1
	 			column = 1   
				width = medium
			)
			Minimum_Balance
			(
				type = decimal
				displayname = "Minimum Balance"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Requires_Debit_Card
			(
    			type = checkbox
				displayname = "Requires Debit Card"
				initial value = false
	 			row = 1
	 			column = 1   
				width = medium
			)
			Bank_Terms
			(
    			type = richtext
				displayname = "Bank Terms"
				height = 200px
				toolbar = enable
				[
					style, font-color, background-color, link, bullets-and-numbering, 
					font-size : {1, 2, 3, 4, 5, 6, 7}
				]
	 			row = 1
	 			column = 1   
				width = medium
			)
			Customer_Signature
			(
    			type = signature
				displayname = "Customer Signature"
	 			row = 1
	 			column = 1   
				width = medium
				personal data = true
			)
			Account_Number
			(
    			type = autonumber
				displayname = "Account Number"
				start index = 100001
	 			row = 1
	 			column = 1   
				width = medium
			)
			Yearly_Interest
			(
				type = decimal
				displayname = "Yearly Interest"
	 			row = 1
	 			column = 1   
				width = medium
    			Formula_Properties
    			(
    						value =  input.FD_Amount * input.Interest_Rate / 100
    						visibility = true
    			)
			)
			QR_Code
			(
				type = qrcode
				displayname = "Account QR Code"
				value = "Account No: ${Account_Number} | Name: ${Customer_Name}"
	 			row = 1
	 			column = 1   
				width = medium
			)
			FD_Maturity_Date
			(
    			type = date
				displayname = "FD Maturity Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			Account_Status
			(
				type = picklist
				displayname = "Account Status"
				maxchar = 100
				values = {"Applied","KYC Pending","Approved","Active","Closed"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			Nominee_Details
			(
				type = grid
				displayname = "Nominee Details"
				Name
				(
    				type = name
     				prefix
     				(
	     				 type = prefix
	     				 displayname ="Prefix"
	     				 visibility = false
	     				 value = {"Mr.","Mrs.","Ms."}
     				) 
     				first_name
     				(
	     				 type = first_name
	     				 displayname ="First Name"
     				) 
     				last_name
     				(
	     				 type = last_name
	     				 displayname ="Last Name"
     				) 
     				suffix
     				(
	     				 type = suffix
	     				 displayname ="Suffix"
	     				 visibility = false
     				) 
					width = medium
					personal data = true
				)
				Relationship
				(
					type = picklist
					maxchar = 100
					values = {"Parents","Husband","Wife","Guardian"}
					width = medium
				)
	 			row = 2
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
			blueprint components
			{
				stages = {"Stage1","Stage2","Stage3","Active","Closed","Applied","KYC Verified"}
			}
		}
		form Branch_Master
		{
			displayname = "Branch Master"
			success message = "Branch Master Added Successfully"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			Branch_Name
			(
    			type = text
				displayname = "Branch Name"
	 			row = 1
	 			column = 1   
				width = medium
			)
			IFSC_Code
			(
    			type = text
				displayname = "IFSC Code"
	 			row = 1
	 			column = 1   
				width = medium
			)
			City
			(
    			type = text
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
		form Loan_Application_Form
		{
			displayname = "Loan Application Form"
			success message = "Loan Application Added Successfully"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			Loan_Type
			(
				type = picklist
				displayname = "Loan Type"
				maxchar = 100
				values = {"Home Loan","Education Loan","Personal Loan"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			Tenure_Months
			(
				type = number
				displayname = "Tenure Months"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Loan_Status
			(
				type = picklist
				displayname = "Loan Status"
				maxchar = 100
				values = {"Applied","Approved","Rejected"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			Loan_Amount
			(
				displayname = "Loan Amount"
				type = INR
				format = commadotindian
	 			row = 1
	 			column = 1   
				width = medium
			)
			Loan_Interest_Rate
			(
    			type = percentage
				displayname = "Loan Interest Rate"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Monthly_EMI
			(
				displayname = "Monthly EMI"
				type = INR
				format = commadotindian
	 			row = 1
	 			column = 1   
				width = medium
			)
			Account
			(
				type = picklist	
				values  = Account_Opening_Form.ID
    			displayformat = [Account_Number]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
		form Transaction_Form
		{
			displayname = "Transaction Form"
			success message = "Transaction Added Successfully"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			Transaction_Type
			(
				type = picklist
				displayname = "Transaction Type"
				maxchar = 100
				values = {"Deposit","Withdrawal","Fund Transfer"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			Transaction_Date
			(
    			type = date
				displayname = "Transaction Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			Remarks
			(
    			type = textarea
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Amount
			(
				type = INR
				format = commadotindian
	 			row = 1
	 			column = 1   
				width = medium
			)
			Account
			(
				type = picklist	
				values  = Account_Opening_Form.ID
    			displayformat = [Account_Number]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
	}
	reports
	{
		default list All_Branch_Masters
		{
			displayName = "All Branch Masters"
			show all rows from Branch_Master    
			(
				Branch_Name as "Branch Name"
				IFSC_Code as "IFSC Code"
				City
			)
		}
		default list Account_Opening_Form_Report
		{
			displayName = "Account Opening Form Report"
			show all rows from Account_Opening_Form    
			(
				Customer_Name  as "Customer Name"
				Email_Address as "Email Address"
				Mobile_Number as "Mobile Number"
				(
					displayformat = plainnumber 
				)
				Residential_Address  as "Residential Address"
	 			(
	      			enable = Link_to_Map,Show_As_Text
	 			)
				PAN_Number as "PAN Number"
				Opening_Deposit as "Opening Deposit"
				Date_of_Birth as "Date of Birth"
				Purpose_of_Account as "Purpose of Account"
				Preferred_Visit_Time as "Preferred Visit Time"
				Account_Type as "Account Type"
				Customer_Category as "Customer Category"
				Services_Required as "Services Required"
				Agree_To_Bank_Terms as "Agree To Bank Terms"
				Branch_Master as "Branch Master"
				Customer_Photo as "Customer Photo"
				KYC_Document as "KYC Document"
				Current_Balance as "Current Balance"
				FD_Amount as "FD Amount"
				Interest_Rate as "Interest Rate"
				Submitted_On as "Submitted On"
				Company_Website as "Company Website"
				Minimum_Balance as "Minimum Balance"
				Requires_Debit_Card as "Requires Debit Card"
				Bank_Terms as "Bank Terms"
				Customer_Signature as "Customer Signature"
				Account_Number as "Account Number"
				Yearly_Interest as "Yearly Interest"
				QR_Code as "Account QR Code"
				FD_Maturity_Date as "FD Maturity Date"
				Account_Status as "Account Status"
				Nominee_Details.Name as "Nominee Details"
			)
		}
		default list All_Transactions
		{
			displayName = "All Transactions"
			show all rows from Transaction_Form    
			(
				Transaction_Type as "Transaction Type"
				Transaction_Date as "Transaction Date"
				Remarks
				Amount
				Account
			)
		}
		default list All_Loan_Applications
		{
			displayName = "All Loan Applications"
			show all rows from Loan_Application_Form    
			(
				Loan_Type as "Loan Type"
				Tenure_Months as "Tenure Months"
				Loan_Status as "Loan Status"
				Loan_Amount as "Loan Amount"
				Loan_Interest_Rate as "Loan Interest Rate"
				Monthly_EMI as "Monthly EMI"
				Account
			)
		}
		kanban aAccount_Status_Kanban
		{
			displayName = "aAccount Status Kanban"
			show all rows from Account_Opening_Form    
			(
				Customer_Name  as "Customer Name"
				Email_Address as "Email Address"
				Mobile_Number as "Mobile Number"
				(
					displayformat = plainnumber 
				)
				Residential_Address  as "Residential Address"
	 			(
	      			enable = Link_to_Map,Show_As_Text
	 			)
				PAN_Number as "PAN Number"
				Opening_Deposit as "Opening Deposit"
				Date_of_Birth as "Date of Birth"
				Purpose_of_Account as "Purpose of Account"
				Preferred_Visit_Time as "Preferred Visit Time"
				Account_Type as "Account Type"
				Customer_Category as "Customer Category"
				Services_Required as "Services Required"
				Agree_To_Bank_Terms as "Agree To Bank Terms"
				Customer_Photo as "Customer Photo"
				Branch_Master as "Branch Master"
				KYC_Document as "KYC Document"
				Current_Balance as "Current Balance"
				FD_Amount as "FD Amount"
				Interest_Rate as "Interest Rate"
				Submitted_On as "Submitted On"
				Company_Website as "Company Website"
				Minimum_Balance as "Minimum Balance"
				Requires_Debit_Card as "Requires Debit Card"
				Bank_Terms as "Bank Terms"
				Customer_Signature as "Customer Signature"
				Account_Number as "Account Number"
				Yearly_Interest as "Yearly Interest"
				QR_Code as "Account QR Code"
				FD_Maturity_Date as "FD Maturity Date"
				Account_Status as "Account Status"
			)
			options
			(
	 			display field = Account_Status
	 		)
		}
		calendar FD_Maturity_Calendar
		{
			displayName = "FD Maturity Calendar"
			show all rows from Account_Opening_Form    
			(
				Customer_Name  as "Customer Name"
				Email_Address as "Email Address"
				Mobile_Number as "Mobile Number"
				(
					displayformat = plainnumber 
				)
				Residential_Address  as "Residential Address"
	 			(
	      			enable = Link_to_Map,Show_As_Text
	 			)
				PAN_Number as "PAN Number"
				Opening_Deposit as "Opening Deposit"
				Date_of_Birth as "Date of Birth"
				Purpose_of_Account as "Purpose of Account"
				Preferred_Visit_Time as "Preferred Visit Time"
				Account_Type as "Account Type"
				Customer_Category as "Customer Category"
				Services_Required as "Services Required"
				Agree_To_Bank_Terms as "Agree To Bank Terms"
				Customer_Photo as "Customer Photo"
				Branch_Master as "Branch Master"
				KYC_Document as "KYC Document"
				Current_Balance as "Current Balance"
				FD_Amount as "FD Amount"
				Interest_Rate as "Interest Rate"
				Submitted_On as "Submitted On"
				Company_Website as "Company Website"
				Minimum_Balance as "Minimum Balance"
				Requires_Debit_Card as "Requires Debit Card"
				Bank_Terms as "Bank Terms"
				Customer_Signature as "Customer Signature"
				Account_Number as "Account Number"
				Yearly_Interest as "Yearly Interest"
				QR_Code as "Account QR Code"
				FD_Maturity_Date as "FD Maturity Date"
				Account_Status as "Account Status"
			)
			options
			(
				display field = Account_Number
				start date = FD_Maturity_Date
			)
		}
	}
	pages
	{
		page Bank_Command_Center
		{
			displayname = "Bank Command Center"
			Content="<zml    \t\t\n\t\t\n\t\t\n\t\t\n\t\t\n>\n\t<layout>\n\t<row>\n\t<column\n   \t\t width='50%'\n   \t>\n\t<panel elementName='Panel'\n \n >\n\t<pr \n\t\t\twidth='fill'\n\t\theight='fill'\n>\n\t<pc \n\t\tpadding = '20px'\n\tbgColor = '#FFFFFF'\n\n\t\twidth = '100%'\n\t\thAlign = 'center'\n\t\tvAlign = 'middle'\n>\n\t<pr \n\t\t\twidth='auto'\n\t\theight='auto'\n>\n\t<pc \n\t\tpadding = '5px'\n\n>\n\t<pr \n\t>\n\t<pc \n\t\n>\n\t<text \n\n\tmargin = '0px'\n\tpadding = '0px'\n\tcolor = '#FF4C2F'\n\tsize = '36px'\n\tbold = 'true' \n\ttype = 'Form Data'\n\n\tbgColor = 'transparent'\n        bgColorType = 'noFill'\n\tcornerRadius = '0px'\n\n\n\tdisplayType = 'actual'\n\tdecimalPlaces = '2'\n\tthousandsSeperator = 'COMMA'\n\tdecimalSeperator = 'DOT'\n\tnumberScale = 'none'\n\n\n\n    borderColor = '#FF4C2F'\n    borderWidth = '0px'\n\n\t  value = 'thisapp.Account_Opening_Form.Current_Balance.sum'\n>\n</text>\n\n</pc>\n</pr><pr \n\t>\n\t<pc \n\t\n>\n\t<text \n\n\tmargin = '0px'\n\tpadding = '0px'\n\tcolor = '#333333'\n\tsize = '16px'\n\ttype = 'Text'\n\n\tbgColor = 'transparent'\n        bgColorType = 'noFill'\n\tcornerRadius = '0px'\n\n\n\n\n\n    borderColor = '#333333'\n    borderWidth = '0px'\n\n\t  value = 'Total Bank Balance (Rs.)'\n>\n</text>\n\n</pc>\n</pr>\n</pc>\n</pr>\n</pc>\n</pr>\n</panel>\n</column><column\n   \t\t width='50%'\n   \t>\n\t<row>\n\t<column\n   \t\t width='100%'\n   \t>\n\t<chart \n\telementName='Chart'\n\n\ttype = 'Column'\n\tbgColor = '#FFFFFF'\n\ttheme = 'theme1'\n\tlegendPos = 'center.top'\n\theightType = 'auto'\n\theightValue = '300px'\n\tappLinkName = 'thisapp'\n\tformLinkName = 'Account_Opening_Form'\n\txfield = 'Account_Type'\n\tyfields = 'sum:Current_Balance'\n/>\n\n</column>\n</row><row>\n\t<column\n   \t\t width='100%'\n   \t>\n\t<report \n\telementName='Report'\n\n\t\tappLinkName = 'thisapp'\n\t\tlinkName = 'Account_Opening_Form_Report'\n\t\n\t\tiszreport = 'false'\n\theightType = 'auto'\n\theightValue = '700'\n/>\n</column>\n</row>\n</column>\n</row><row>\n\t<column\n   \t\t width='100%'\n   \t>\n\t<widgets elementName='Widget' importedTemplate='true'/>\n</column>\n</row>\n</layout>\n</zml>"
		}
