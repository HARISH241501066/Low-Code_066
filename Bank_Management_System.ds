		batchworkflow
		{
			Monthly_Savings_Interest_
			{
    			display name = "Monthly Savings Interest Credit"
    			type = batchworkflow
    			form = Account_Opening_Form
    			event = "On Schedule"
    			start = "01-Nov-2026 00:30:00"
    			frequency = monthly
    			batch size = 1000
    			status = active
    			on execute 
    			{
					actions 
					{
						custom deluge script
						(
											// DS-08 | Batch workflow: Monthly Savings Interest Credit (runs monthly, 1000 records per block)
										// Credits monthly interest at 3% per year to every Active Savings account
										if(input.Account_Type == "Savings" && input.Account_Status == "Active")
										{
											bal = ifnull(input.Current_Balance,0);
											monthlyInterest = (bal * (3 / 100) / 12).round(2);
											input.Current_Balance = bal + monthlyInterest;
										}
						)
					}
    			}
			}
		}

